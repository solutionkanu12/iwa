# Rust / Soroban build artifacts
target/
**/target/

# Node
node_modules/
**/node_modules/

# Compiled wasm build outputs
*.wasm

# Circuit build outputs / generated keys (heavy, regenerated by build)
circuits-artifacts/
**/circuits-artifacts/

# Soroban test snapshots (auto-generated by the test runner each run)
**/test_snapshots/

# Starknet Foundry cache
**/.snfoundry_cache/

# Reference fork — Nethermind stellar-private-payments (not our code)
stellar-private-payments/

# Local helper scripts (machine-specific)
_run/

# TypeScript incremental build cache.
#
# `tsc -b` writes one of these beside every tsconfig it builds, in any
# workspace. iwa-web already ignored its own; this covers the backend and
# anything added later, so a stray cache cannot be committed by accident.
*.tsbuildinfo

# OS / editor cruft
.DS_Store
*.swp

# Secrets / env / local wallet + deploy identities (never commit)
.env
.env.*
!.env.example
.stellar/
.soroban/
