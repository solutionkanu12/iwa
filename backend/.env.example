# IWA backend environment. Copy to .env for local development.
# NEVER commit a real .env. This service holds no custody and no key material:
# there is deliberately no variable here for a wallet key, a seed phrase, a
# viewing key, or a member signing key, because it must never have one.

PORT=8080
NODE_ENV=development

# Postgres. Railway and Render both inject this automatically.
DATABASE_URL=postgres://postgres:postgres@localhost:5432/iwa
# Set true when the provider terminates TLS (managed Postgres usually does).
DATABASE_SSL=false

# Read-only Starknet mainnet RPC, used by the public event indexer.
STARKNET_RPC_URL=https://api.cartridge.gg/x/starknet/mainnet

# Exact frontend origins, comma separated. A wildcard is refused, and in
# production this must not be empty.
CORS_ORIGINS=http://localhost:5173

# Run the indexer in this process. Set false on a second replica so only one
# instance advances the cursor.
INDEXER_ENABLED=true
INDEXER_INTERVAL_MS=30000
# Block the deployment went live; a cold database starts here.
INDEXER_START_BLOCK=14160000
