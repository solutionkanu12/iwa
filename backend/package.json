{
  "name": "iwa-backend",
  "private": true,
  "version": "0.1.0",
  "license": "MIT",
  "type": "module",
  "description": "IWA coordination and indexing service. Holds no custody and no secrets.",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "start": "node dist/index.js",
    "dev": "tsx watch src/index.ts",
    "migrate": "node dist/migrate.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "dev:memory": "tsx src/devServer.ts"
  },
  "dependencies": {
    "express": "^5.1.0",
    "pg": "^8.13.1",
    "starknet": "10.5.0",
    "zod": "^3.24.0"
  },
  "devDependencies": {
    "@types/express": "^5.0.0",
    "@types/node": "^24.0.0",
    "@types/pg": "^8.11.10",
    "@types/supertest": "^6.0.2",
    "supertest": "^7.0.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vitest": "^4.1.11"
  }
}
