{
  "name": "iwa-celo-circle",
  "version": "0.0.0",
  "private": true,
  "description": "Non-custodial Iwa rotating-savings circle on Celo (cNGN)",
  "scripts": {
    "compile": "hardhat compile",
    "test": "hardhat test",
    "test:mainnet-chainid": "hardhat test test-mainnet-chainid/IwaCircleCelo.mainnetChainId.test.ts --config hardhat.mainnetChainId.config.ts",
    "test:foundry:setup": "forge install --no-git foundry-rs/forge-std",
    "test:foundry": "forge test",
    "test:foundry:ci": "FOUNDRY_PROFILE=ci forge test",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@nomicfoundation/hardhat-toolbox": "^5.0.0",
    "@openzeppelin/contracts": "5.6.1",
    "hardhat": "^2.26.0",
    "typescript": "^5.6.0"
  }
}
