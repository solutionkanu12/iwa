# Frontend environment. Copy to .env.local for local overrides.
# Never commit real values; .env.local is gitignored.

# Coordination service. Defaults to http://localhost:8080 when unset.
VITE_BACKEND_URL=https://iwa-production-2900.up.railway.app

# Supabase Auth public browser configuration. Use only the project URL and
# publishable/anon key here; never expose the service-role key to the frontend.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Operator console at /strk20. Internal tooling: class hashes, funding figures
# and dry-build internals. Always available in development; in production it
# appears only when this is exactly "true". Anything else hides the route.
VITE_ENABLE_OPERATOR_CONSOLE=false
