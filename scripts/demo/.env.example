# IWA STRK20 demo secrets — copy to .env.local and fill in.
#
# .env.local is gitignored. NEVER commit real values, and never put any of
# these in demo.config.json.
#
# Load them with Node itself, per command:
#   node --env-file=.env.local 00_prepare.mjs
#
# Every value is validated on load (hex shape, curve range, https scheme) and
# no value is ever printed by this tooling.

# --- Operator Starknet account (pays gas, submits every transaction) ---
IWA_ACCOUNT_ADDRESS=0x
IWA_ACCOUNT_PRIVATE_KEY=0x

# --- STRK20 private viewing key (a Stark-curve scalar) ---
# This key decrypts the account's own notes. It cannot spend funds, but under
# authorized recovery an auditor can read this account's history with it.
IWA_VIEWING_KEY=0x

# --- Demo member identities ---
# member_ref = poseidon([IWA_INVITE_V1, secret, auth_public_key]).
# The auth private key signs settlement authorizations; it is not a Starknet
# account key and holds no funds directly.
IWA_MEMBER_A_SECRET=0x
IWA_MEMBER_A_AUTH_PRIVATE_KEY=0x
IWA_MEMBER_B_SECRET=0x
IWA_MEMBER_B_AUTH_PRIVATE_KEY=0x

# --- STRK20 proving service ---
# Required only for --confirm-send. Dry runs use the SDK's mock prover against
# a read-only pool view and never contact this endpoint.
IWA_PROVER_URL=https://
